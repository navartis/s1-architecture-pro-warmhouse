@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Context.puml

title Умный дом. Диаграмма контекста.

Person(user, "Пользователь", "'Управляет' датчиками и запрашивает температуру")
System(smarthome, "Умный дом", "Монолит на Go: учёт датчиков и чтение температуры")
System_Ext(temperature_api, "temperature-api", "Имитация датчиков температуры")
Rel(user, smarthome, "Использует", "REST/HTTPS")
Rel(smarthome, temperature_api, "Запрашивает температуру", "HTTP")

@enduml
