@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Context.puml

title Умный дом. Диаграмма контекста.

Person(user, "Пользователь", "Регистрирует датчики и смотрит температуру")
System(smarthome, "Умный дом", "Монолит на Go: реестр датчиков и чтение температуры")
System_Ext(devices, "Датчики и системы отопления", "Оборудование в домах пользователей; сейчас имитируется заглушкой temperature-api")

Rel(user, smarthome, "Использует", "REST/HTTPS")
Rel(smarthome, devices, "Запрашивает температуру", "HTTP")

@enduml
