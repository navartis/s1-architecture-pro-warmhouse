@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Component.puml

title Heating Service. Диаграмма компонента.

Container(gateway, "API Gateway", "REST", "Единая точка входа")
Container(device, "Device Service", "Go", "Реестр устройств и команды")
System_Ext(devices, "Устройства и датчики", "Партнёрские устройства")

Container_Boundary(heating_svc, "Heating Service") {
  Component(api, "REST API", "REST", "Приём запросов управления отоплением от API Gateway")
  Component(logic, "Heating Logic", "REST", "Проверка параметров, режим и целевая температура")
  Component(client, "Device Client", "REST", "Отправка команды в Device Service")
}

Rel(gateway, api, "Управление отоплением", "REST")
Rel(api, logic, "Передаёт запрос")
Rel(logic, client, "Формирует команду")
Rel(client, device, "Команда устройству", "REST")
Rel(device, devices, "Отправляет команды", "MQTT / протоколы устройств")

@enduml
